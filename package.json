{
  "name": "drshabnam-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:seo": "node --test tests/seo-output.test.mjs",
    "test:worker": "node --test tests/worker.test.mjs",
    "test:indexnow": "node --test tests/indexnow.test.mjs",
    "test:seo:http": "node --test tests/seo-http.test.mjs",
    "indexnow:check": "node scripts/indexnow.mjs --dry-run",
    "indexnow:submit": "node scripts/indexnow.mjs --submit",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
